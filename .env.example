# Environment Variables
# Copy this file to .env and fill in your values

# Example: Analytics
# VITE_ANALYTICS_ID=UA-XXXXXXXX-X

# Example: API endpoints (if needed)
# VITE_API_URL=https://api.example.com

# Note: Most configuration is done in src/config/site.ts
# Environment variables are only needed for sensitive data or environment-specific values
